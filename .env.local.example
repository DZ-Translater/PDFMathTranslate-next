# PDFMathTranslate Environment Configuration Example
# Copy this file to .env.local and update with your values

# Translation Service API Keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Object Storage Configuration (Optional)
# Set to false to disable object storage uploads
ENABLE_OBJECT_STORAGE=true

# Your object storage API endpoint for presigned URLs
STORAGE_API_URL=https://your-storage-api.com

# Authentication token for storage API
STORAGE_API_TOKEN=your-storage-api-token

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info