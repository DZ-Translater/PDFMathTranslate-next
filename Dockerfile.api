# API Server Dockerfile
# 使用 uv 官方镜像作为基础镜像
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

# 设置工作目录
WORKDIR /app

# 暴露 API 端口
EXPOSE 8000

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV HOST=0.0.0.0
ENV PORT=8000
ENV LOG_LEVEL=info

# 安装系统依赖
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    libgl1 \
    libglib2.0-0 \
    libxext6 \
    libsm6 \
    libxrender1 \
    build-essential && \
    rm -rf /var/lib/apt/lists/*

# 复制所有项目文件
COPY . .

# 安装 Python 依赖
RUN uv sync --no-dev

# 预热 babeldoc 资源
RUN uv run babeldoc --version && uv run babeldoc --warmup

# 创建必要的目录
RUN mkdir -p /app/configs /app/pdf2zh_files

# 验证安装
RUN uv run python -c "import pdf2zh_next; print(f'pdf2zh-next version: {pdf2zh_next.__version__}')"
RUN uv run python -c "import api_server; print('API server module OK')"

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# 启动 API Server
CMD ["uv", "run", "python", "api_server.py"]
